<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hr_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Пацієнти">
                <field name="name"/>
                <field name="birth_date"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="doctor_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Пацієнт">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="ПІБ пацієнта"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Особиста інформація">
                            <field name="birth_date"/>
                            <field name="gender"/>
                            <field name="active"/>
                        </group>
                        <group string="Контакти та лікар">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="doctor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Візити">
                            <field name="visit_ids">
                                <list>
                                    <field name="visit_date"/>
                                    <field name="doctor_id"/>
                                    <field name="disease_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Пацієнти</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
