<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_mass_reassign_doctor_wizard_form" model="ir.ui.view">
        <field name="name">mass.reassign.doctor.wizard.form</field>
        <field name="model">mass.reassign.doctor.wizard</field>
        <field name="arch" type="xml">
            <form string="Масове перевизначення персонального лікаря">
                <group>
                    <field name="new_doctor_id"/>
                    <field name="change_date"/>
                </group>
                <footer>
                    <button name="action_reassign_doctor"
                            string="Перевизначити"
                            type="object"
                            class="btn-primary"/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action, available from the Patient list view "Action" menu -->
    <record id="action_mass_reassign_doctor_wizard" model="ir.actions.act_window">
        <field name="name">Масове перевизначення персонального лікаря</field>
        <field name="res_model">mass.reassign.doctor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
