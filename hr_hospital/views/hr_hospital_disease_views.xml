<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_hr_hospital_disease_list" model="ir.ui.view">
        <field name="name">hr.hospital.disease.list</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list string="Види захворювань">
                <field name="display_name" string="Назва"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form string="Вид захворювання">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Опис">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Підвиди захворювання">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View with Hierarchical SearchPanel -->
    <record id="view_hr_hospital_disease_search" model="ir.ui.view">
        <field name="name">hr.hospital.disease.search</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search string="Пошук захворювань">
                <field name="name" string="Назва захворювання"/>
                <field name="parent_id" string="Батьківське захворювання"/>
                <separator/>
                <filter name="has_children" string="Категорії"
                        domain="[('child_ids', '!=', False)]"/>
                <filter name="no_parent" string="Кореневі захворювання"
                        domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter name="group_by_parent" string="За категорією"
                            context="{'group_by': 'parent_id'}"/>
                </group>
                <searchpanel>
                    <field name="parent_id" string="Ієрархія захворювань"
                           select="one" icon="fa-folder"
                           enable_counters="1" hierarchize="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_hospital_disease" model="ir.actions.act_window">
        <field name="name">Види захворювань</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
