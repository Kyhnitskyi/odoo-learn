<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hr_hospital_doctor_history_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.tree</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list string="Історія персональних лікарів">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.form</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form string="Історія персональних лікарів">
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="assignment_date"/>
                        <field name="change_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_hospital_doctor_history" model="ir.actions.act_window">
        <field name="name">Історія персональних лікарів</field>
        <field name="res_model">hr.hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
