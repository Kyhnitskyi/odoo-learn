<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.list</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Лікарі">
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="is_intern"/>
                <field name="supervising_doctor_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Лікар">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="ПІБ лікаря"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Загальна інформація">
                            <field name="specialization"/>
                            <field name="category_id"/>
                            <field name="is_intern" invisible="1"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"
                                   domain="[('is_intern', '=', False)]"/>
                            <field name="supervising_doctor_id"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Контакти">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Медична інформація">
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Інтерни" invisible="not intern_ids">
                            <field name="intern_ids">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name" class="fw-bold"/>
                                            <field name="specialization"/>
                                            <field name="phone"/>
                                            <field name="email"/>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Пацієнти">
                            <field name="patient_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="birth_date"/>
                                    <field name="gender"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.kanban</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id">
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Редагувати</a>
                        <a role="menuitem" type="object" name="action_archive"
                           class="dropdown-item" t-if="record.active.raw_value">Архівувати</a>
                        <a role="menuitem" type="object" name="action_unarchive"
                           class="dropdown-item" t-if="!record.active.raw_value">Розархівувати</a>
                        <a role="menuitem" t-if="widget.deletable" type="delete"
                           class="dropdown-item">Видалити</a>
                    </t>
                    <t t-name="card">
                        <field name="is_intern" invisible="1"/>
                        <field name="intern_names" invisible="1"/>
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted">
                            <field name="specialization"/>
                        </div>
                        <div t-if="record.category_id.raw_value" class="mt-1">
                            <span class="badge text-bg-secondary">
                                <field name="category_id"/>
                            </span>
                        </div>
                        <div>
                            <i class="fa fa-phone me-1" title="Телефон" role="img"/>
                            <field name="phone"/>
                        </div>
                        <div t-if="record.is_intern.raw_value" class="mt-1">
                            <span class="badge text-bg-info">Інтерн</span>
                        </div>
                        <div t-if="record.intern_names.raw_value" class="mt-2">
                            <strong>Інтерни:</strong>
                            <field name="intern_names"/>
                        </div>
                        <div class="mt-2">
                            <button name="action_quick_visit_to_doctor"
                                    type="object"
                                    string="Записатись"
                                    class="btn btn-sm btn-primary"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Пошук лікарів">
                <field name="name" string="ПІБ лікаря"/>
                <field name="specialization" string="Спеціалізація"/>
                <field name="category_id" string="Категорія"/>
                <separator/>
                <filter name="is_intern" string="Інтерни"
                        domain="[('is_intern', '=', True)]"/>
                <filter name="is_mentor" string="Ментори"
                        domain="[('intern_ids', '!=', False)]"/>
                <filter name="active" string="Активні"
                        domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_by_category" string="За категорією"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_specialization" string="За спеціалізацією"
                            context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Лікарі</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
