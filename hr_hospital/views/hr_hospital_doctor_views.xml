<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.list</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Лікарі">
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="supervising_doctor_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Лікар">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="ПІБ лікаря"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Загальна інформація">
                            <field name="specialization"/>
                            <field name="category_id"/>
                            <field name="is_intern" invisible="1"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"
                                   domain="[('is_intern', '=', False)]"/>
                            <field name="supervising_doctor_id"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Контакти">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Медична інформація">
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Пацієнти">
                            <field name="patient_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="birth_date"/>
                                    <field name="gender"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Лікарі</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
