<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hr_hospital_doctor_category_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.tree</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list string="Кваліфікації лікарів">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_hospital_doctor_category_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.form</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form string="Кваліфікація лікаря">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Лікарі">
                            <field name="doctor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_hospital_doctor_category" model="ir.actions.act_window">
        <field name="name">Кваліфікації лікарів</field>
        <field name="res_model">hr.hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
